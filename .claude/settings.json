{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(python3 scripts/capture.py *)",
      "Bash(python3 scripts/ledger.py *)",
      "Bash(python3 scripts/verify_gate.py *)",
      "Bash(python3 scripts/publish_state.py *)",
      "Bash(python scripts/capture.py *)",
      "Bash(python scripts/ledger.py *)",
      "Bash(python scripts/verify_gate.py *)",
      "Bash(python scripts/publish_state.py *)",
      "Bash(python3 scripts/new_job.py *)",
      "Bash(python scripts/new_job.py *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "WebSearch",
      "WebFetch(domain:laws-lois.justice.gc.ca)",
      "WebFetch(domain:laws.gnb.ca)",
      "WebFetch(domain:www2.gnb.ca)",
      "WebFetch(domain:www.gnb.ca)",
      "WebFetch(domain:www.courtsnb-coursnb.ca)",
      "WebFetch(domain:decisions.scc-csc.ca)",
      "WebFetch(domain:www.sac-isc.gc.ca)",
      "WebFetch(domain:www.rcaanc-cirnac.gc.ca)",
      "WebFetch(domain:www.gazette.gc.ca)",
      "WebFetch(domain:www.canlii.org)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git remote *)",
      "Bash(git commit --amend*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Edit(/jobs/*/evidence/raw/**)",
      "Edit(/jobs/*/evidence/text/**)",
      "Edit(/jobs/*/evidence/ledger.jsonl)",
      "Edit(/jobs/*/state/published.jsonl)",
      "Edit(/jobs/*/gate/required_sources.json)",
      "Edit(/jobs/*/sources/**)",
      "Edit(/sources/governing/**)",
      "Edit(/scripts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "command": "python3 -c 'import pypdf' 2>/dev/null || python3 -m pip install --break-system-packages -q pypdf >/dev/null 2>&1; python3 -c 'import pypdf; print(\"[session start] pypdf\", pypdf.__version__, \"ready: PDF captures get text versions\")' 2>/dev/null || echo '[session start] pypdf NOT AVAILABLE: PDF captures will have no text version. Report this before capturing PDFs.'"
          }
        ]
      }
    ]
  }
}
